{
  "name": "dairyfarmapp",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run start:dev -w apps/api",
    "api:test": "npm run test -w apps/api",
    "mobile": "npm run start -w apps/mobile",
    "shared:build": "npm run build -w packages/shared",
    "typecheck": "npm run build -w packages/shared && npm run typecheck -w apps/api && npm run typecheck -w apps/mobile",
    "postinstall": "node scripts/postinstall.js",
    "test": "npm run test -w apps/api"
  }
}
