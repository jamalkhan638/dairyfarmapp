# Copy to deploy/.env and fill in. Generate secrets with: openssl rand -hex 32
DB_PASSWORD=
JWT_SECRET=
# You type this once in the app to create the owner account.
SETUP_CODE=
# Local port the API listens on (Caddy forwards to it). SupplyMeadow uses 3000, so do not use that.
API_PORT=3100
BACKUP_DIR=/var/backups/dairy
