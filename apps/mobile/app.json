{
  "expo": {
    "name": "Dairy Farm",
    "slug": "dairyfarm",
    "scheme": "dairyfarm",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.dairyfarm.app",
      "adaptiveIcon": {
        "backgroundColor": "#E8F3EA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 2,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-image",
      [
        "expo-localization",
        {
          "supportsRTL": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Dairy Farm to use your photos for animal pictures and receipts.",
          "cameraPermission": "Allow Dairy Farm to use the camera for animal pictures and receipts."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "supportsRTL": true,
      "apiUrl": "https://dairy.supplymeadow.site/api",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8504aa57-6682-4703-a4bc-d9fd74fdd3d9"
      }
    },
    "owner": "jamalahmad638"
  }
}
