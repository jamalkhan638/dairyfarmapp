// Dairy farm database.
//
// Conventions for every synced business record:
//   id              UUID generated on the phone (so offline records keep their id)
//   version         increases by 1 on every change; used to detect conflicting edits
//   createdById     always the authenticated user; never changes after creation
//   updatedById     the authenticated user who last changed it
//   clientCreatedAt / clientUpdatedAt  when the user saved it on the phone
//   deletedAt       soft delete; records are never physically removed
// Farm dates are "YYYY-MM-DD" strings in Pakistan time.
// Money is in paisa, milk in millilitres, feed in grams (all integers).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  WORKER
}

enum AnimalStatus {
  MILKING
  DRY
  YOUNG
  SOLD
  DECEASED
}

enum Sex {
  FEMALE
  MALE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  CONFLICT_RESOLVED
}

enum ConflictStatus {
  OPEN
  RESOLVED
}

enum ConflictType {
  DUPLICATE
  EDIT
  EDIT_DELETED
  DELETE_EDITED
}

// ---------- Users & access ----------

model User {
  id           String   @id @db.Uuid
  name         String
  username     String   @unique
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  language     String   @default("ur")
  /// Increment to invalidate all of a user's sessions and force a full re-download.
  accessVersion Int     @default(1)
  createdById  String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedById  String?  @db.Uuid
  updatedAt    DateTime @updatedAt
  version      Int      @default(1)

  permissions   Permission[]
  refreshTokens RefreshToken[]
}

model Permission {
  userId    String  @db.Uuid
  module    String
  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
}

model RefreshToken {
  id         String    @id @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String
  deviceName String?
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------- History & sync bookkeeping ----------

/// One row per change to any record: who, what, when, and the field values before/after.
model AuditLog {
  id         BigInt      @id @default(autoincrement())
  entity     String
  recordId   String      @db.Uuid
  action     AuditAction
  userId     String      @db.Uuid
  at         DateTime    @default(now())
  clientTime DateTime?
  mutationId String?     @db.Uuid
  /// { field: { from, to } }
  changes    Json

  @@index([entity, recordId])
}

/// Every mutation id the server has processed, so a re-sent change is applied only once.
model SyncMutation {
  id          String   @id @db.Uuid
  userId      String   @db.Uuid
  entity      String
  recordId    String   @db.Uuid
  op          String
  /// The MutationResult returned the first time.
  result      Json
  processedAt DateTime @default(now())
}

/// Ordered change feed the phones download from. seq order = commit order
/// because all writes take the same advisory lock.
model SyncChange {
  seq      BigInt   @id @default(autoincrement())
  entity   String
  recordId String   @db.Uuid
  at       DateTime @default(now())

  @@index([entity, recordId])
}

/// A change from a phone that could not be applied without overwriting someone else's data.
model SyncConflict {
  id            String         @id @db.Uuid
  entity        String
  recordId      String         @db.Uuid
  type          ConflictType
  status        ConflictStatus @default(OPEN)
  mutationId    String         @db.Uuid
  /// The mutation as the phone sent it.
  mine          Json
  /// The server record at the time of the conflict.
  theirs        Json?
  theirsVersion Int?
  /// For DUPLICATE: the id of the existing record it collides with.
  existingId    String?        @db.Uuid
  resolution    String?
  createdById   String         @db.Uuid
  createdAt     DateTime       @default(now())
  resolvedById  String?        @db.Uuid
  resolvedAt    DateTime?
  version       Int            @default(1)
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

// ---------- Animals ----------

model Animal {
  id                 String       @id @db.Uuid
  tag                String
  name               String?
  breed              String?
  sex                Sex          @default(FEMALE)
  birthDate          String?
  birthDateEstimated Boolean      @default(false)
  purchaseDate       String?
  purchasePricePaisa Int?
  motherId           String?      @db.Uuid
  photoId            String?      @db.Uuid
  notes              String?
  /// Derived from the latest AnimalStatusChange; not edited directly.
  status             AnimalStatus @default(MILKING)
  statusDate         String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  statusChanges AnimalStatusChange[]

  // Tag uniqueness among non-deleted animals is a partial unique index (see migration).
  @@index([tag])
}

model AnimalStatusChange {
  id            String       @id @db.Uuid
  animalId      String       @db.Uuid
  status        AnimalStatus
  effectiveDate String
  reason        String?
  animal        Animal       @relation(fields: [animalId], references: [id])

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([animalId, effectiveDate])
}

// ---------- Files ----------

/// Photo/receipt metadata. The file itself lives in object storage under storageKey.
model Attachment {
  id          String    @id @db.Uuid
  entity      String
  recordId    String    @db.Uuid
  contentType String
  sizeBytes   Int
  storageKey  String
  uploadedAt  DateTime?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([entity, recordId])
}

// ---------- Milk ----------

enum MilkSession {
  MORNING
  EVENING
}

enum MilkUsageType {
  CALF_FED
  HOME
  DISCARDED
}

/// Milk from one cow at one milking. A missing record means "not recorded", never zero.
model MilkRecord {
  id         String      @id @db.Uuid
  animalId   String      @db.Uuid
  date       String
  session    MilkSession
  quantityMl Int
  note       String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  // One live record per cow/date/session: partial unique index in the migration.
  @@index([date])
  @@index([animalId, date])
}

/// Milk that was not sold: fed to calves, used at home, or thrown away.
model MilkUsage {
  id         String        @id @db.Uuid
  date       String
  type       MilkUsageType
  quantityMl Int
  animalId   String?       @db.Uuid
  note       String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([date])
}

// ---------- Sales ----------

enum SaleType {
  CASH
  CREDIT
}

enum PaymentMethod {
  CASH
  BANK
  MOBILE
}

model Customer {
  id              String   @id @db.Uuid
  name            String
  phone           String?
  address         String?
  notes           String?
  defaultSaleType SaleType @default(CREDIT)
  active          Boolean  @default(true)

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid
}

/// Price per litre for one customer, from effectiveFrom until the next rate.
model CustomerRate {
  id                String  @id @db.Uuid
  customerId        String  @db.Uuid
  ratePaisaPerLitre Int
  effectiveFrom     String
  note              String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([customerId, effectiveFrom])
}

/// Milk given to a customer. amountPaisa is always calculated by the server.
model MilkDelivery {
  id                String      @id @db.Uuid
  customerId        String      @db.Uuid
  date              String
  session           MilkSession
  quantityMl        Int
  ratePaisaPerLitre Int
  amountPaisa       Int
  saleType          SaleType
  /// The payment created with a cash sale.
  cashPaymentId     String?     @db.Uuid
  note              String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([date])
  @@index([customerId, date])
}

/// Money received from a customer. Separate from deliveries; partial payments are normal.
model CustomerPayment {
  id          String        @id @db.Uuid
  customerId  String        @db.Uuid
  date        String
  amountPaisa Int
  method      PaymentMethod
  /// Set when this payment was created automatically for a cash sale.
  deliveryId  String?       @db.Uuid
  note        String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([customerId, date])
}

// ---------- Feed & suppliers ----------

enum FeedCategory {
  CONCENTRATE
  GREEN_FODDER
  SILAGE
  MINERAL
  OTHER
}

model Supplier {
  id      String  @id @db.Uuid
  name    String
  phone   String?
  address String?
  notes   String?
  active  Boolean @default(true)

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid
}

model FeedItem {
  id             String       @id @db.Uuid
  name           String
  category       FeedCategory
  /// Weight of one bag in grams; null for loose feed.
  bagWeightGrams Int?
  notes          String?
  active         Boolean      @default(true)

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid
}

/// Feed bought: adds to stock. Not an expense; feeding it is.
model FeedPurchase {
  id             String   @id @db.Uuid
  feedItemId     String   @db.Uuid
  supplierId     String?  @db.Uuid
  date           String
  quantityGrams  Int
  bags           Float?
  totalPaisa     Int
  /// Calculated by the server: totalPaisa per kg.
  costPerKgPaisa Int
  paymentType    SaleType
  cashPaymentId  String?  @db.Uuid
  note           String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([feedItemId, date])
  @@index([supplierId])
}

/// Money paid to a supplier. Separate from purchases; partial payments are normal.
model SupplierPayment {
  id          String        @id @db.Uuid
  supplierId  String        @db.Uuid
  date        String
  amountPaisa Int
  method      PaymentMethod
  /// Set when created automatically for a cash purchase.
  purchaseId  String?       @db.Uuid
  /// Set when created automatically for an expense paid now to a supplier.
  expenseId   String?       @db.Uuid
  note        String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([supplierId, date])
}

/// Feed given on a day. One animal = individual feeding; several = shared (cost per cow is an estimate).
model FeedConsumption {
  id            String   @id @db.Uuid
  feedItemId    String   @db.Uuid
  date          String
  quantityGrams Int
  wastedGrams   Int      @default(0)
  animalIds     String[] @db.Uuid
  note          String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([date])
  @@index([feedItemId, date])
}

/// Stock correction after counting the store.
model StockAdjustment {
  id          String  @id @db.Uuid
  feedItemId  String  @db.Uuid
  date        String
  changeGrams Int
  reason      String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([feedItemId])
}

// ---------- Expenses, capital, settings ----------

enum ExpenseCategory {
  VET
  MEDICINE
  LABOUR
  ELECTRICITY
  TRANSPORT
  REPAIRS
  OTHER
}

enum CapitalType {
  ANIMAL_PURCHASE
  EQUIPMENT
  OWNER_INVESTMENT
  OWNER_WITHDRAWAL
  ANIMAL_SALE
}

/// Daily running cost. Counts towards operating profit.
model Expense {
  id             String          @id @db.Uuid
  date           String
  category       ExpenseCategory
  amountPaisa    Int
  description    String?
  supplierId     String?         @db.Uuid
  paymentType    SaleType        @default(CASH)
  method         PaymentMethod   @default(CASH)
  cashPaymentId  String?         @db.Uuid
  animalId       String?         @db.Uuid
  receiptPhotoId String?         @db.Uuid

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([date])
  @@index([supplierId])
}

/// Cow purchases/sales, equipment, owner money in/out. Never part of operating profit.
model CapitalEntry {
  id             String        @id @db.Uuid
  date           String
  type           CapitalType
  amountPaisa    BigInt
  description    String?
  method         PaymentMethod @default(CASH)
  animalId       String?       @db.Uuid
  receiptPhotoId String?       @db.Uuid

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([date])
}

/// One record (fixed id): farm-wide settings such as the opening cash balance.
model FarmSettings {
  id               String  @id @db.Uuid
  farmName         String?
  gestationDays    Int     @default(283)
  pregnancyCheckDays Int   @default(60)
  heatRepeatDays   Int     @default(21)
  openingCashPaisa BigInt  @default(0)
  openingCashDate  String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid
}

// ---------- Health & breeding ----------

enum HealthType {
  ILLNESS
  TREATMENT
  VACCINATION
  DEWORMING
  OTHER
}

enum BreedingType {
  HEAT
  INSEMINATION
  PREGNANCY_CHECK
  CALVING
  ABORTION
}

enum InseminationMethod {
  AI
  NATURAL
}

enum PregnancyResult {
  PREGNANT
  NOT_PREGNANT
}

model HealthEvent {
  id                String     @id @db.Uuid
  animalId          String     @db.Uuid
  date              String
  type              HealthType
  title             String
  medicine          String?
  dose              String?
  vetName           String?
  /// Milk must not be sold up to and including this date.
  withdrawalEndDate String?
  nextDueDate       String?
  /// The cost lives in this expense (never stored twice).
  expenseId         String?    @db.Uuid
  notes             String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([animalId, date])
}

/// Heat, insemination, pregnancy check, calving, abortion. Pregnancy status is worked out from these.
model BreedingEvent {
  id         String              @id @db.Uuid
  animalId   String              @db.Uuid
  date       String
  type       BreedingType
  method     InseminationMethod?
  sire       String?
  technician String?
  result     PregnancyResult?
  calfId     String?             @db.Uuid
  calfSex    Sex?
  notes      String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([animalId, date])
}

/// A reminder added by a user, or a record that an automatic reminder was done (sourceKey).
model Reminder {
  id        String  @id @db.Uuid
  animalId  String? @db.Uuid
  dueDate   String
  title     String
  sourceKey String?
  done      Boolean @default(false)
  notes     String?

  version         Int       @default(1)
  createdById     String    @db.Uuid
  createdAt       DateTime  @default(now())
  clientCreatedAt DateTime?
  updatedById     String    @db.Uuid
  updatedAt       DateTime  @updatedAt
  clientUpdatedAt DateTime?
  deletedAt       DateTime?
  deletedById     String?   @db.Uuid

  @@index([dueDate])
}
