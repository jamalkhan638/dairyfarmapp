DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dairy
PORT=3000
# Long random strings. Generate with: openssl rand -hex 32
JWT_SECRET=change-me
# Needed once, to create the owner account from the app's first-run screen.
SETUP_CODE=change-me-too
# local = save files under ./storage (development). s3 = MinIO or any S3-compatible store.
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=dairy
S3_ACCESS_KEY=
S3_SECRET_KEY=
